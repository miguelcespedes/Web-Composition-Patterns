{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/web-composition-pattern.schema.json",
  "title": "Web Composition Pattern",
  "description": "Metadata for one interactive web composition pattern SVG.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "uid",
    "id",
    "name",
    "category",
    "tags",
    "descriptionEs",
    "svg",
    "viewBox",
    "regions"
  ],
  "properties": {
    "uid": {
      "type": "string",
      "format": "uuid",
      "description": "Globally unique and stable identifier for this layout."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable slug used by the catalog and the SVG filename."
    },
    "name": {
      "type": "string",
      "enum": ["Centered Hero Composition", "Split Hero Composition", "Story Flow Composition", "Minimal Hero Composition", "Editorial Hero Composition", "Asymmetric Hero Composition", "Full-Bleed Image Hero", "Video Hero", "Product Showcase Hero", "Form Hero", "Announcement Hero", "Social Proof Hero", "Pricing Hero", "Interactive Hero", "Dark Mode Hero", "Typographic Hero", "Hero Carousel", "Product Carousel", "Testimonial Carousel", "Logo Carousel", "Gallery Carousel", "Card Carousel", "Content Carousel", "Pricing Table", "Plan Comparison", "Tiered Pricing", "Monthly Annual Toggle", "Feature Comparison", "Recommended Plan", "Usage-Based Pricing", "Pricing Cards"],
      "description": "Pattern name. Structural names remain in English."
    },
    "category": {
      "type": "string",
      "enum": ["Landing Pages"],
      "description": "Catalog category. Category names remain in English."
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "description": "Filter and search tags generated by the catalog."
    },
    "descriptionEs": {
      "type": "string",
      "minLength": 1,
      "description": "Reader-facing explanatory copy in Spanish."
    },
    "svg": {
      "type": "string",
      "pattern": "^assets/[a-z0-9]+(?:-[a-z0-9]+)*\\.svg$",
      "description": "Path to the independent pattern SVG."
    },
    "viewBox": {
      "type": "string",
      "pattern": "^0 0 [1-9][0-9]* [1-9][0-9]*$",
      "description": "SVG viewBox in the format: 0 0 width height."
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/region"
      },
      "description": "Semantic SVG regions available for hover explanations."
    }
  },
  "$defs": {
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "labelEn",
        "explanationEs",
        "color",
        "shape"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Stable region identifier matching the SVG element id and data-region-id value."
        },
        "role": {
          "type": "string",
          "enum": ["canvas", "shell", "hero", "support", "media", "action"],
          "description": "Semantic role used by the color convention."
        },
        "labelEn": {
          "type": "string",
          "description": "Structural label shown in English."
        },
        "explanationEs": {
          "type": "string",
          "minLength": 1,
          "description": "Multiline tooltip explanation shown in Spanish."
        },
        "color": {
          "type": "string",
          "enum": ["transparent", "#E7ECEF", "#9DD9FF", "#D9EAD3", "#E1D5E7", "#171615"],
          "description": "Semantic fill color."
        },
        "shape": {
          "type": "string",
          "enum": ["canvas", "rectangle", "pill"],
          "description": "Conceptual shape used by the region."
        },
        "required": {
          "type": "boolean",
          "default": true,
          "description": "Whether this region is required for this pattern."
        }
      }
    }
  }
}
